# Discord Bot Token (Lấy từ Discord Developer Portal)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Client ID của bot (Application ID)
CLIENT_ID=YOUR_CLIENT_ID_HERE

# Discord ID của Owner duy nhất có quyền tạo key bản quyền bot
OWNER_ID=YOUR_DISCORD_USER_ID

# Khóa bí mật mã hóa token người dùng (AES-256)
TOKEN_SECRET=your_secret_encryption_key_here

# Guild ID (để trống nếu deploy Global cho tất cả máy chủ)
GUILD_ID=

# Port cho webhook nhận thông báo claim từ sniper bên ngoài (tùy chọn)
WEBHOOK_PORT=3000

# Secret key bảo vệ webhook
WEBHOOK_SECRET=your_secret_key_here

# ==============================================================================
# CẤU HÌNH LIÊN KẾT SHOP GỐC (UPSTREAM QUEUE FORWARDER)
# Dùng để tự động bấm nút, điền token & số lượt vào server shop gốc
# ==============================================================================
# User token của tài khoản Discord cá nhân của bạn (acc đang có credit bên shop gốc)
UPSTREAM_USER_TOKEN=

# ID server của shop gốc (ví dụ server HQ Shop Queue)
UPSTREAM_GUILD_ID=

# ID kênh chứa bảng queue của shop gốc
UPSTREAM_CHANNEL_ID=

# ID tin nhắn chứa nút "Dùng credit" của shop gốc
UPSTREAM_MESSAGE_ID=

# ID kênh log claim của shop gốc (để bot bạn tự động bắt thông báo khi săn trúng)
UPSTREAM_CLAIM_CHANNEL_ID=
